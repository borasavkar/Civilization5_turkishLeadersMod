<?xml version="1.0" encoding="utf-8"?>
<Mod id="8b1f7c52-4e0a-4d6e-9a1b-5c2f3e7d9a10" version="1">
  <Properties>
    <Name>Türk Liderleri (Turkish Leaders)</Name>
    <Stability>Beta</Stability>
    <Teaser>Osman Bey, Orhan Gazi, Fatih, Yavuz, Battal Gazi ve Atatürk ile altı yeni Türk medeniyeti ve Avrupa-Orta Doğu-Afrika haritası.</Teaser>
    <Description>Altı yeni medeniyet ekler: Kayı Beyliği (Osman Bey), Osmanlı Beyliği (Orhan Gazi), Osmanlı Devleti (Fatih Sultan Mehmet), Osmanlı Hilafeti (Yavuz Sultan Selim), Uç Gazileri (Seyyid Battal Gazi) ve Türkiye Cumhuriyeti (Mustafa Kemal Atatürk). Her medeniyetin kendine özgü yeteneği, birimi ve binası vardır. Ayrıca gerçek coğrafyaya dayanan, tarihî başlangıç noktalı bir Avrupa, Orta Doğu ve Afrika haritası içerir. Brave New World gerektirir.</Description>
    <Authors>Bora Şavkar</Authors>
    <HideSetupGame>0</HideSetupGame>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
    <SupportsHotSeat>1</SupportsHotSeat>
    <SupportsMac>1</SupportsMac>
    <ReloadAudioSystem>0</ReloadAudioSystem>
    <ReloadLandmarkSystem>0</ReloadLandmarkSystem>
    <ReloadStrategicViewSystem>0</ReloadStrategicViewSystem>
    <ReloadUnitSystem>0</ReloadUnitSystem>
  </Properties>
